# Token de lectura de TMDB (API Read Access Token, v4).
# Conseguilo gratis en https://www.themoviedb.org/settings/api
# Sin token, la app usa un catálogo de ejemplo.
VITE_TMDB_TOKEN=

# Supabase (próximo paso). Sin esto, la app usa el backend local (localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
